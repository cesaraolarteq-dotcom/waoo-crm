APP_NAME="Waoo CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waoo_crm
DB_USERNAME=waoo
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
DB_QUEUE_RETRY_AFTER=120
FILESYSTEM_DISK=local

# Disabled by default; sandbox-only work, never production authorization.
WAOO_SANDBOX_STAFF=false
WAOO_SANDBOX_FINANCE=false
WAOO_SANDBOX_QUOTES=false
WAOO_SANDBOX_IMPORTS=false
WAOO_SANDBOX_DOCUMENTS=false
# Enable only after redacting /r/* and redirect Location from host/proxy/APM logs.
WAOO_SHORT_PORTAL_LINKS=false
STRIPE_TEST_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_ACCOUNT=

# Private mail sandbox only. Disabled transport remains bound in AppServiceProvider.
WAOO_SANDBOX_MAIL=false
WAOO_SANDBOX_MAIL_BOUNCES=false
# Dedicated inbound Postmark HTTP Basic credentials; never send credentials or real values to git.
WAOO_POSTMARK_BOUNCE_USERNAME=
WAOO_POSTMARK_BOUNCE_PASSWORD=
WAOO_POSTMARK_SERVER_ID=
WAOO_POSTMARK_MESSAGE_STREAM=

WAOO_SANDBOX_TIPS=false

# Internal unpaid inventory backing; no provider, payment route or reminder activation.
WAOO_SANDBOX_QUICK_STRIPE=false
WAOO_SANDBOX_QUICK_PAYMENTS=false
WAOO_SANDBOX_QUICK_PAYMENT_NOTIFICATIONS=false
WAOO_SANDBOX_IMMEDIATE_CONTRACTS=false

# Private archive only; no operational events, payments or sends.
WAOO_SANDBOX_HISTORY=false
# Read-only independent HoneyBook verification and audited customer correction.
WAOO_SANDBOX_HISTORY_VERIFICATION=false
# Per-event optional company billing; no customer identity change.
WAOO_SANDBOX_COMPANY=false
# Owner aggregate analytics and birthday campaign preparation only. No sending.
WAOO_SANDBOX_ANALYTICS=false
WAOO_SANDBOX_ANNIVERSARY=false

# Dedicated server-to-server availability preparation; keep disabled until separately reviewed.
WAOO_SANDBOX_WEB_AVAILABILITY=false
WAOO_AVAILABILITY_SHARED_SECRET=
