APP_NAME="Waoo CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waoo_crm
DB_USERNAME=waoo
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
DB_QUEUE_RETRY_AFTER=120
FILESYSTEM_DISK=local

# Disabled by default; sandbox-only work, never production authorization.
WAOO_SANDBOX_STAFF=false
WAOO_SANDBOX_FINANCE=false
WAOO_SANDBOX_QUOTES=false
WAOO_SANDBOX_IMPORTS=false
WAOO_SANDBOX_DOCUMENTS=false
STRIPE_TEST_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_ACCOUNT=

# Private mail sandbox only. Disabled transport remains bound in AppServiceProvider.
WAOO_SANDBOX_MAIL=false
WAOO_SANDBOX_MAIL_BOUNCES=false
# Dedicated inbound Postmark HTTP Basic credentials; never send credentials or real values to git.
WAOO_POSTMARK_BOUNCE_USERNAME=
WAOO_POSTMARK_BOUNCE_PASSWORD=
WAOO_POSTMARK_SERVER_ID=
WAOO_POSTMARK_MESSAGE_STREAM=
